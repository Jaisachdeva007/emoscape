<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.unity3d.player">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Quest / OpenXR: declare VR support so the app is discoverable and launches in headset mode -->
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <uses-feature android:name="oculus.software.handtracking" android:required="false" />

  <application>
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|questpro" />
    <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
  </application>
</manifest>
